# Copy this file to .env and fill in your values

# PORT is set automatically by Render/cloud platforms — leave blank locally
PORT=5000

GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model used to turn survey answers into profile fields
# GROQ_EXTRACT_MODEL=openai/gpt-oss-20b

# Supabase Postgres connection string
# Find it in Supabase: Project Settings -> Database -> Connection string
# Use the Session pooler string - the direct db.<ref>.supabase.co host is IPv6-only
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage (for uploaded survey audio) and login-token checks
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Optional: Project Settings -> API -> JWT Secret. Without it, login tokens
# are checked against the project's public keys at SUPABASE_URL instead.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: shared secret the daily retrain job sends as X-Retrain-Secret.
# Leave unset locally; set it on Render and as a GitHub repository secret.
# RETRAIN_SECRET=pick_a_long_random_string
