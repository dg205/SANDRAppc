# Copy this file to .env and fill in your values

# For PRODUCTION (Render/cloud): set this to your deployed backend URL
# EXPO_PUBLIC_API_URL=https://your-app-name.onrender.com

# For LOCAL DEV only: set this to your machine's LAN IP so Android/iOS can reach it
# EXPO_PUBLIC_LAN_IP=192.168.x.x

# Supabase Auth - from the Supabase dashboard -> Settings -> API
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Shows dev-only test tooling (signup quick-fill, Dev Tools screen).
# Already on for local dev via __DEV__; set to "1" for the preview build,
# leave unset for production.
# EXPO_PUBLIC_ENABLE_TEST_MODE=1
